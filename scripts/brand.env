# SPDX-License-Identifier: GPL-3.0-or-later
# The product's names, for the build scripts (sourced by bash and zsh). The app's code has its own
# copy in Sources/WispCommon/Brand.swift; scripts/bundle-app.sh refuses to build if the two disagree.
# To rename the product, change both. See "Renaming" in docs/development.md.

BRAND_NAME="Wisp"   # display name: BRAND_NAME.app, menus, DMG volume name
BRAND_CLI="wisp"    # command-line name; also the SwiftPM executable target (.build/release/wisp)
# Placeholder reverse-DNS: a fork should use a domain it controls. Changing it resets macOS
# permissions and the app's defaults.
BRAND_BUNDLE_ID="com.pier20.Wisp"
BRAND_COPYRIGHT="Copyright © 2026 the Wisp contributors. GPL-3.0-or-later."
BRAND_VERSION="1.0.4"

# Signing, per machine. Leave these empty here; set them in your environment or in
# scripts/brand.local.env (not tracked; the scripts source it right after this file), e.g.
#   BRAND_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
#   BRAND_NOTARY_PROFILE="my-notary-profile"   # from: xcrun notarytool store-credentials
BRAND_SIGN_IDENTITY="${BRAND_SIGN_IDENTITY:-}"
BRAND_NOTARY_PROFILE="${BRAND_NOTARY_PROFILE:-}"

# The self-signed identity scripts/make-dev-cert.sh creates for local builds.
BRAND_DEV_CERT="$BRAND_NAME Dev"

# Updates (Sparkle, embedded in Developer ID builds; see Sources/wisp/App/Updates.swift). The feed is
# the appcast.xml that .github/workflows/release.yml attaches to each GitHub release; the public key
# checks the EdDSA signature of every update (scripts/setup-release-secrets.sh makes the key pair).
# A fork must use its own repository and key, or leave the key empty for builds without updates.
BRAND_FEED_URL="${BRAND_FEED_URL:-https://github.com/pier20-ai/wisp/releases/latest/download/appcast.xml}"
BRAND_SPARKLE_PUBLIC_KEY="${BRAND_SPARKLE_PUBLIC_KEY:-MSv7FJExZD1jz2yIYtwcaoOinZjXE4Htl5WIGZPwufE=}"
SPARKLE_VERSION="2.10.1"
SPARKLE_SHA256="1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27"
